{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "final-gate-report.schema.json",
  "title": "FinalGateReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "run_id", "cycle_id", "candidate_id", "candidate_content_hash", "gate_report_id", "role_id", "gate_id", "overall_pass", "candidate_manifest", "rendered_pdf", "final_report"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "pattern": "^fg-[a-f0-9]{32}$"},
    "run_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "integer", "minimum": 0},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gate_report_id": {"type": "string", "pattern": "^g-[a-f0-9]{32}$"},
    "role_id": {"enum": ["W22", "W51", "W53"]},
    "gate_id": {"enum": ["correctness_math", "manifest_integrity", "pdf_valid"]},
    "overall_pass": {"const": true},
    "candidate_manifest": {"$ref": "#/$defs/artifact"},
    "rendered_pdf": {"$ref": "#/$defs/artifact"},
    "final_report": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256"],
      "properties": {
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
