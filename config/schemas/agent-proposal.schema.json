{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-proposal.schema.json",
  "title": "AgentProposal",
  "description": "Auditável por evidência; não contém nem solicita cadeia de raciocínio privada.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "role_id", "cycle_id", "base_hash", "scope", "evidence_locators", "patch_or_operations", "affected_claims", "dependencies", "risk", "confidence", "requested_validations", "prompt_version"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "proposal_id": {"type": "string", "minLength": 1},
    "role_id": {"type": "string", "pattern": "^(M00|S[1-5]0|W[1-5][1-3])$"},
    "cycle_id": {"type": "integer", "minimum": 0},
    "base_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "patch_or_operations": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "patch"],
          "properties": {
            "kind": {"const": "unified_diff"},
            "patch": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operations"],
          "properties": {
            "kind": {"const": "operations"},
            "operations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["op", "target", "value"],
                "properties": {
                  "op": {"enum": ["add", "replace", "remove", "annotate"]},
                  "target": {"type": "string", "minLength": 1},
                  "value": {"type": ["string", "null"]}
                }
              }
            }
          }
        }
      ]
    },
    "affected_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "factors", "technical_effect_possible"],
      "properties": {
        "level": {"enum": ["low", "medium", "high", "critical"]},
        "factors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "technical_effect_possible": {"type": "boolean"}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "requested_validations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prompt_version": {"type": "string", "minLength": 1}
  }
}
