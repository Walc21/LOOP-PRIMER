{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Decision Ledger Schema (M1.1 / ADR-001)",
  "required": [
    "schema_version",
    "decision_id",
    "cycle",
    "type",
    "target_id",
    "verdict",
    "rationale",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "decision_id": {
      "type": "string",
      "pattern": "^dec-[a-f0-9]{8,64}$"
    },
    "cycle": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "enum": [
        "promote_champion",
        "update_pareto",
        "reject_candidate",
        "trigger_stagnation",
        "final_accept",
        "final_reject"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^(cand|snap|chk)-[a-f0-9]{8,64}$"
    },
    "verdict": {
      "type": "string",
      "enum": ["accepted", "rejected", "diverged", "stagnant"]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
