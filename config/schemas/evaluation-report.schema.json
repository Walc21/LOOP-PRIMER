{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-report.schema.json",
  "title": "EvaluationReport",
  "description": "Relatório agregado e auditável da avaliação cega externa do candidato.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "run_id",
    "cycle_id",
    "comparison_id",
    "candidate_id",
    "base_hash",
    "candidate_content_hash",
    "gate_report_id",
    "gate_report_locator",
    "order_seed",
    "diversity_assurance",
    "total_jurors",
    "consistent_jurors",
    "divergent_jurors",
    "challenger_wins",
    "champion_wins",
    "ties",
    "meta_confirmed",
    "overall_outcome",
    "challenger_eligible",
    "correctness_math_pass",
    "juror_evaluations",
    "meta_verdict",
    "verdict_ids",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "evaluation_id": {"type": "string", "pattern": "^eval-[a-f0-9]{32}$"},
    "run_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "integer", "minimum": 0},
    "comparison_id": {"type": "string", "pattern": "^cmp-[a-f0-9]{64}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "base_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gate_report_id": {"type": "string", "minLength": 1},
    "gate_report_locator": {"type": "string", "minLength": 1},
    "order_seed": {"type": "integer", "minimum": 0},
    "diversity_assurance": {"enum": ["full_diversity", "reduced_diversity_assurance"]},
    "total_jurors": {"type": "integer", "const": 3},
    "consistent_jurors": {"type": "integer", "minimum": 0, "maximum": 3},
    "divergent_jurors": {"type": "integer", "minimum": 0, "maximum": 3},
    "challenger_wins": {"type": "integer", "minimum": 0, "maximum": 3},
    "champion_wins": {"type": "integer", "minimum": 0, "maximum": 3},
    "ties": {"type": "integer", "minimum": 0, "maximum": 3},
    "meta_confirmed": {"type": "boolean"},
    "overall_outcome": {"enum": ["challenger_favored", "champion_favored", "tie", "inconclusive"]},
    "challenger_eligible": {"type": "boolean"},
    "correctness_math_pass": {"type": "boolean"},
    "juror_evaluations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "juror_id",
          "specialty",
          "model_family",
          "consistent",
          "inconsistency_reason",
          "inferred_winner",
          "candidate_b_math_pass",
          "verdict_ab_id",
          "verdict_ba_id"
        ],
        "properties": {
          "juror_id": {"type": "string", "minLength": 1},
          "specialty": {"type": "string", "minLength": 1},
          "model_family": {"type": "string", "minLength": 1},
          "consistent": {"type": "boolean"},
          "inconsistency_reason": {"type": ["string", "null"]},
          "inferred_winner": {"type": ["string", "null"], "enum": ["A", "B", "tie", null]},
          "candidate_b_math_pass": {"type": "boolean"},
          "verdict_ab_id": {"type": "string", "minLength": 1},
          "verdict_ba_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "meta_verdict": {"type": "object"},
    "verdict_ids": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evaluated_at": {"type": "string", "format": "date-time"}
  }
}
