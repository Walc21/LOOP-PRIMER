{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-manifest.schema.json",
  "title": "RunManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "state", "cycle_id", "input", "config_hash", "budget_config_hash", "role_ids"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["NEW", "INGESTED", "SOURCE_READY", "CYCLE_PLANNED", "DEPARTMENTS_RUNNING", "SYNTHESIS_READY", "CANDIDATE_BUILT", "GATES_PASSED", "EVALUATED", "DIAGNOSED", "DECIDED", "COMMITTING", "CYCLE_COMPLETE", "PAUSED", "FINALIZED", "TECHNICAL_FAILURE"]},
    "cycle_id": {"type": "integer", "minimum": 0},
    "input": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ingested_input"}]},
    "config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "budget_config_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "role_ids": {"type": "array", "minItems": 21, "maxItems": 21, "uniqueItems": true, "items": {"type": "string", "pattern": "^(M00|S[1-5]0|W[1-5][1-3])$"}},
    "current_candidate_id": {"type": ["string", "null"], "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "NEW"}}, "required": ["state"]},
      "then": {"properties": {"input": {"const": null}}},
      "else": {"properties": {"input": {"$ref": "#/$defs/ingested_input"}}}
    }
  ],
  "$defs": {
    "ingested_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "source_mode", "source_zip"],
      "properties": {
        "path": {"const": "input/inbox/artigo.pdf"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "source_mode": {"enum": ["SOURCE_ZIP", "PDF_ONLY_RECONSTRUCTION"]},
        "source_zip": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["safe_path", "sha256", "size_bytes", "safe_inspection_passed"],
              "properties": {
                "safe_path": {"const": "input/inbox/source.zip"},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "size_bytes": {"type": "integer", "minimum": 1},
                "safe_inspection_passed": {"const": true}
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"source_mode": {"const": "SOURCE_ZIP"}}, "required": ["source_mode"]},
          "then": {"properties": {"source_zip": {"type": "object"}}},
          "else": {"properties": {"source_zip": {"const": null}}}
        }
      ]
    }
  }
}
