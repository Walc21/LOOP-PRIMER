{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-task.schema.json",
  "title": "AgentTask",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "run_id", "cycle_id", "role_id", "activation_mode", "created_at", "base_hash", "scope", "input_locators", "requested_output_schema", "prompt_version", "constraints"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "integer", "minimum": 0},
    "role_id": {"type": "string", "pattern": "^(S[1-5]0|W[1-5][1-3])$"},
    "activation_mode": {"enum": ["RUN", "CHECK", "SHIFT", "FREEZE"]},
    "created_at": {"type": "string", "format": "date-time"},
    "base_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requested_output_schema": {"enum": ["department-packet.schema.json", "agent-proposal.schema.json"]},
    "prompt_version": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"role_id": {"pattern": "^S[1-5]0$"}}, "required": ["role_id"]},
      "then": {"properties": {"requested_output_schema": {"const": "department-packet.schema.json"}}}
    },
    {
      "if": {"properties": {"role_id": {"pattern": "^W[1-5][1-3]$"}}, "required": ["role_id"]},
      "then": {"properties": {"requested_output_schema": {"const": "agent-proposal.schema.json"}}}
    }
  ]
}
