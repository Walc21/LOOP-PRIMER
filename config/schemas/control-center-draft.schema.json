{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control-center-draft.schema.json",
  "title": "ControlCenterConfigurationDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "created_at", "config_path", "base_hash", "candidate_hash", "status", "validation", "diff", "value"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "draft_id": {"type": "string", "pattern": "^draft-[a-f0-9]{32}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "config_path": {"type": "string", "pattern": "^config/(system|budgets|gates|decision-policy)\\.yaml$|^config/roles/(M00|S[1-5]0|W[1-5][1-3])\\.yaml$|^config/rubrics/evaluation\\.yaml$"},
    "base_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["DRAFT", "VALIDATED", "APPLIED"]},
    "validation": {"type": "object", "additionalProperties": false, "required": ["valid", "messages"], "properties": {"valid": {"type": "boolean"}, "messages": {"type": "array", "items": {"type": "string", "maxLength": 512}}}},
    "diff": {"type": "array", "maxItems": 512, "items": {"type": "object", "additionalProperties": false, "required": ["path", "before", "after"], "properties": {"path": {"type": "string", "maxLength": 512}, "before": {}, "after": {}}}},
    "value": {"type": "object"},
    "applied_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
