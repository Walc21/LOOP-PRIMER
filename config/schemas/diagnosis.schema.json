{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnosis.schema.json",
  "title": "Diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagnosis_id", "run_id", "cycle_id", "candidate_id", "candidate_content_hash", "base_hash", "created_at", "gate_report_id", "gate_report_hash", "evaluation_report_hash", "history_hash", "verdict_ids", "window_size", "mde", "classification", "signals", "recommended_mode", "focus", "evidence_locators"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "diagnosis_id": {"type": "string", "pattern": "^diag-[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "integer", "minimum": 0},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "gate_report_id": {"type": "string", "minLength": 1},
    "gate_report_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation_report_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "history_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verdict_ids": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "window_size": {"type": "integer", "minimum": 1},
    "mde": {"type": "number", "minimum": 0, "maximum": 5},
    "classification": {"enum": ["EVOLVING", "LOCAL_PLATEAU", "GLOBAL_PLATEAU", "OSCILLATING", "REGRESSING", "INCONCLUSIVE", "TECHNICAL_FAILURE"]},
    "signals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recommended_mode": {"enum": ["RUN", "CHECK", "SHIFT", "FREEZE"]},
    "focus": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
