{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inference-receipt.schema.json",
  "title": "InferenceReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "run_id", "cycle_id", "task_id",
    "role_id", "call_id", "reservation_id", "route_decision_hash",
    "routing_policy_hash", "provider", "model", "target_id", "backend_type",
    "independence_group", "prompt_hash", "response_hash",
    "requested_output_schema", "input_tokens", "output_tokens", "cache_tokens",
    "usage_available", "cost_microunits", "currency", "wall_time_seconds",
    "finish_reason", "attempt", "escalation_from", "escalation_reason",
    "created_at", "receipt_hash"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
    "receipt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "cycle_id": {"type": "integer", "minimum": 0},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "role_id": {"type": ["string", "null"]},
    "routing_role_id": {"type": "string", "pattern": "^(M00|S[1-5]0|W[1-5][1-3])$"},
    "actor_kind": {"const": "evaluator"},
    "actor_id": {"enum": ["juror-math", "juror-contrib", "juror-clarity", "meta-reviewer"]},
    "call_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "reservation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "route_decision_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "routing_policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "backend_type": {"enum": ["fake", "local_openai_compatible", "remote_openai_compatible"]},
    "independence_group": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "prompt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "response_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "output_locator": {"type": ["string", "null"], "minLength": 1, "maxLength": 2048},
    "context_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "privacy_mode": {"enum": ["deny_remote", "scoped_remote", "full_remote"]},
    "requested_output_schema": {"enum": ["department-packet.schema.json", "agent-proposal.schema.json", "jury-verdict.schema.json", "meta-verdict.schema.json"]},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_tokens": {"type": ["integer", "null"], "minimum": 0},
    "usage_available": {"type": "boolean"},
    "cost_microunits": {"type": ["integer", "null"], "minimum": 0},
    "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
    "wall_time_seconds": {"type": "integer", "minimum": 0},
    "finish_reason": {"enum": ["stop", "length", "tool_call", "error", "unknown", "schema_invalid"]},
    "attempt": {"type": "integer", "minimum": 0},
    "escalation_from": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "escalation_reason": {
      "type": ["string", "null"],
      "enum": [null, "BACKEND_FAILURE", "TIMEOUT", "OUTPUT_SCHEMA_INVALID", "MANDATORY_EVIDENCE_MISSING", "DETERMINISTIC_GATE_FAILED", "CROSS_REVIEW_DISAGREEMENT", "INDEPENDENT_JUDGMENT_REQUIRED", "ROUTE_CAPABILITY_INSUFFICIENT"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "receipt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"enum": ["1.1.0", "1.2.0"]}}, "required": ["schema_version"]},
      "then": {"required": ["output_sha256", "output_locator", "context_hash", "privacy_mode"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2.0"}}, "required": ["schema_version"]},
      "then": {
        "required": ["routing_role_id", "actor_kind", "actor_id"],
        "properties": {
          "role_id": {"const": null},
          "requested_output_schema": {"enum": ["jury-verdict.schema.json", "meta-verdict.schema.json"]}
        },
        "allOf": [
          {
            "if": {"properties": {"requested_output_schema": {"const": "jury-verdict.schema.json"}}, "required": ["requested_output_schema"]},
            "then": {"properties": {"actor_id": {"enum": ["juror-math", "juror-contrib", "juror-clarity"]}}},
            "else": {"properties": {"actor_id": {"const": "meta-reviewer"}}}
          }
        ]
      },
      "else": {
        "properties": {
          "role_id": {"type": "string", "pattern": "^(S[1-5]0|W[1-5][1-3])$"},
          "requested_output_schema": {"enum": ["department-packet.schema.json", "agent-proposal.schema.json"]}
        },
        "not": {
          "anyOf": [
            {"required": ["routing_role_id"]},
            {"required": ["actor_kind"]},
            {"required": ["actor_id"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"usage_available": {"const": true}}, "required": ["usage_available"]},
      "then": {
        "properties": {
          "input_tokens": {"type": "integer"},
          "output_tokens": {"type": "integer"},
          "cache_tokens": {"type": "integer"}
        }
      }
    },
    {
      "if": {"properties": {"cost_microunits": {"type": "integer"}}, "required": ["cost_microunits"]},
      "then": {"properties": {"currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}}
    }
  ]
}
