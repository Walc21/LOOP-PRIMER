{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-manifest.schema.json",
  "title": "CandidateManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "candidate_kind", "run_id", "cycle_id", "base_candidate_id", "built_at", "workspace_hash", "content_hash", "source_proposal_ids", "merge_receipt_locator", "immutable"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_kind": {"enum": ["baseline", "challenger"]},
    "run_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "integer", "minimum": 0},
    "base_candidate_id": {"type": ["string", "null"], "minLength": 1},
    "built_at": {"type": "string", "format": "date-time"},
    "workspace_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_proposal_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "merge_receipt_locator": {"type": ["string", "null"], "minLength": 1},
    "immutable": {"const": true},
    "inventory": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size": {"type": "integer", "minimum": 0}}}},
    "merge_receipt": {"type": "object", "additionalProperties": false, "required": ["synthesis_hash", "proposal_hashes", "proposal_receipts", "base_hash"], "properties": {"synthesis_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "proposal_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "proposal_receipts": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["sender_role", "parent_role", "path", "immutable_path", "sha256", "schema_version", "cycle_id"], "properties": {"sender_role": {"type": "string", "pattern": "^W[1-5][1-3]$"}, "parent_role": {"type": "string", "pattern": "^S[1-5]0$"}, "path": {"type": "string", "minLength": 1}, "immutable_path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "schema_version": {"const": "1.1.0"}, "cycle_id": {"type": "integer", "minimum": 0}}}}, "base_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "base_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "synthesis_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "proposal_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "proposal_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prompt_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"candidate_kind": {"const": "baseline"}}, "required": ["candidate_kind"]},
      "then": {
        "properties": {
          "base_candidate_id": {"const": null},
          "source_proposal_ids": {"maxItems": 0},
          "merge_receipt_locator": {"const": null}
        }
      },
      "else": {
        "required": ["base_hash", "proposal_ids", "prompt_versions", "merge_receipt", "synthesis_hash", "proposal_hashes", "inventory"],
        "properties": {
          "base_candidate_id": {"type": "string", "minLength": 1},
          "merge_receipt_locator": {"type": "string", "minLength": 1},
          "source_proposal_ids": {"minItems": 1},
          "proposal_ids": {"minItems": 1}
        }
      }
    }
  ]
}
