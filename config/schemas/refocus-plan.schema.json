{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "refocus-plan.schema.json",
  "title": "RefocusPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "run_id",
    "cycle_id",
    "diagnosis_id",
    "diagnosis_hash",
    "classification",
    "strategy",
    "branches",
    "created_at",
    "evidence_locators"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "plan_id": {"type": "string", "pattern": "^plan-[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "integer", "minimum": 0},
    "diagnosis_id": {"type": "string", "pattern": "^diag-[a-f0-9]{64}$"},
    "diagnosis_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "classification": {
      "enum": ["LOCAL_PLATEAU", "GLOBAL_PLATEAU", "OSCILLATING"]
    },
    "strategy": {
      "enum": ["targeted_bottleneck", "dual_branch", "stabilization"]
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "branch_id",
          "kind",
          "hypothesis",
          "falsification_criteria",
          "target_roles",
          "budget_limit",
          "overlay_versions",
          "overlay_hashes"
        ],
        "properties": {
          "branch_id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["exploitation", "exploration", "targeted", "stabilization"]
          },
          "hypothesis": {"type": "string", "minLength": 1},
          "falsification_criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "target_roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(S[1-5]0|W[1-5][1-3])$"}
          },
          "budget_limit": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_tokens", "max_cost", "max_cycles"],
            "properties": {
              "max_tokens": {"type": "integer", "minimum": 0},
              "max_cost": {"type": "number", "minimum": 0},
              "max_cycles": {"type": "integer", "minimum": 1}
            }
          },
          "overlay_versions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "overlay_hashes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "evidence_locators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"classification": {"const": "GLOBAL_PLATEAU"}}, "required": ["classification"]},
      "then": {
        "properties": {
          "strategy": {"const": "dual_branch"},
          "branches": {
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {"contains": {"properties": {"kind": {"const": "exploitation"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1},
              {"contains": {"properties": {"kind": {"const": "exploration"}}, "required": ["kind"]}, "minContains": 1, "maxContains": 1}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"classification": {"const": "LOCAL_PLATEAU"}}, "required": ["classification"]},
      "then": {
        "properties": {
          "strategy": {"const": "targeted_bottleneck"},
          "branches": {"minItems": 1, "maxItems": 1, "items": {"properties": {"kind": {"const": "targeted"}}, "required": ["kind"]}}
        }
      }
    },
    {
      "if": {"properties": {"classification": {"const": "OSCILLATING"}}, "required": ["classification"]},
      "then": {
        "properties": {
          "strategy": {"const": "stabilization"},
          "branches": {"minItems": 1, "maxItems": 1, "items": {"properties": {"kind": {"const": "stabilization"}}, "required": ["kind"]}}
        }
      }
    }
  ]
}
