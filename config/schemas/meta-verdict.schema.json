{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta-verdict.schema.json",
  "title": "MetaVerdict",
  "description": "Veredito de supervisão e auditoria pelo Meta-Revisor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta_verdict_id",
    "meta_reviewer_id",
    "comparison_id",
    "gate_report_id",
    "confirmed",
    "vetoed",
    "veto_reason",
    "consistent_verdict_count",
    "divergence_count",
    "explanation",
    "evidence_locators",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "meta_verdict_id": {"type": "string", "minLength": 1},
    "meta_reviewer_id": {"type": "string", "minLength": 1},
    "comparison_id": {"type": "string", "minLength": 1},
    "gate_report_id": {"type": "string", "minLength": 1},
    "confirmed": {"type": "boolean"},
    "vetoed": {"type": "boolean"},
    "veto_reason": {"type": ["string", "null"]},
    "consistent_verdict_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "divergence_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "explanation": {"type": "string", "minLength": 1},
    "evidence_locators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "reviewed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"vetoed": {"const": true}}, "required": ["vetoed"]},
      "then": {
        "properties": {
          "confirmed": {"const": false},
          "veto_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
