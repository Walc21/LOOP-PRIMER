{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnosis-manifest.schema.json",
  "title": "DiagnosisManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagnosis_id",
    "run_id",
    "cycle_id",
    "candidate_id",
    "classification",
    "diagnosis_hash",
    "gate_report_hash",
    "evaluation_report_hash",
    "tree_content_hash",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "diagnosis_id": {"type": "string", "pattern": "^diag-[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "integer", "minimum": 0},
    "candidate_id": {"type": "string", "minLength": 1},
    "classification": {
      "enum": [
        "EVOLVING",
        "LOCAL_PLATEAU",
        "GLOBAL_PLATEAU",
        "OSCILLATING",
        "REGRESSING",
        "INCONCLUSIVE",
        "TECHNICAL_FAILURE"
      ]
    },
    "diagnosis_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "gate_report_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation_report_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tree_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
