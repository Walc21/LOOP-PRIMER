# Prime Agent project-local sessions and transient kernel state
.prime/agent/sessions/
.prime/agent/runtime/

# Inputs and derived article artifacts (keep directory sentinels/examples)
*.pdf
*.zip
input/inbox/*
artifacts/original/*
artifacts/extracted/*
artifacts/rendered/*
!**/.gitkeep
!**/*.example.*

# Durable runtime state is local; schemas/configuration remain versioned
state/events/*
state/snapshots/*
state/checkpoints/*
state/claims/*
state/issues/*
state/decisions/*
state/locks/*
state/control-center/*
versions/champion/*
versions/challengers/*
versions/pareto/*
versions/rejected/*
workspaces/*
reports/*
logs/*
!**/.gitkeep
!**/*.example.*
!state/control-center/.gitkeep

# Worktree-local live smoke configuration and evidence
local-smoke/runs/
local-smoke/config/*.local.json

# Secrets and local overrides
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*secrets*.json

# Python/editor caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.idea/
.vscode/
*.swp
*~

# Lock transitório do histórico/contexto para IAs
docs/ai_history.lock
runtime/local-full-cycle/
runtime/m3-diagnostics/
runtime/m3-real-attempts/

# Create-only M6 smoke evidence and explicit M3 selections stay local.
runtime/m6-context-selections/
runtime/m6-official-smokes/
