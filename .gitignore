# Prime Agent project-local sessions and transient kernel state
.prime/agent/sessions/
.prime/agent/runtime/

# Inputs and derived article artifacts (keep directory sentinels/examples)
*.pdf
*.zip
# Public export of the synthetic, audited MVP demonstration.
!docs/evidence/local-qwen-mvp/artigo-original.pdf
!docs/evidence/local-qwen-mvp/registros-qwen.zip
input/inbox/*
artifacts/original/*
artifacts/extracted/*
artifacts/rendered/*
!**/.gitkeep
!**/*.example.*

# Durable runtime state is local; schemas/configuration remain versioned
versions/champion/*
versions/challengers/*
versions/pareto/*
versions/rejected/*
workspaces/*
reports/*
logs/*
!**/.gitkeep
!**/*.example.*
/state/**
!/state/**/
!/state/**/.gitkeep
/runtime/

# Worktree-local live smoke configuration and evidence
local-smoke/runs/
local-smoke/config/*.local.json

# Secrets and local overrides
.env
.env.*
!.env.example
auth.json
.netrc
.pypirc
.aws/
id_rsa
id_ecdsa
id_ed25519
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*secrets*.json

# Python/editor caches and local environments
__pycache__/
*.egg-info/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.idea/
.vscode/
*.swp
*~

# Lock transitório do histórico/contexto para IAs
docs/ai_history.lock
